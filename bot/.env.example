# =============================================================================
# Homebaise Bot Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# =============================================================================
# Telegram Bot Configuration (Required)
# =============================================================================
# Get bot token from: https://t.me/BotFather
# 1. Message @BotFather on Telegram
# 2. Use /newbot command
# 3. Follow instructions and copy token here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# =============================================================================
# Homebaise API Configuration (Required)
# =============================================================================
# URL of your deployed Homebaise application
HOMEBASE_API_URL=https://your-homebaise-app.vercel.app

# Shared token for bot authentication with API
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_SERVER_TOKEN=your_secure_random_token_here

# =============================================================================
# Supabase Configuration (Required)
# =============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =============================================================================
# Server Configuration (Optional - has defaults)
# =============================================================================
PORT=3001
NODE_ENV=production

# =============================================================================
# Bot Options (Optional)
# =============================================================================
# Skip database lookups (demo mode)
BOT_SKIP_DB=false

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
