# =============================================================================
# Homebaise Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# cp .env.example .env.local

# =============================================================================
# Supabase Configuration (Required)
# =============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =============================================================================
# Hedera Network Configuration (Required)
# =============================================================================
# Create account at: https://portal.hedera.com/register
NEXT_PUBLIC_MY_ACCOUNT_ID=0.0.xxxxx
NEXT_PUBLIC_MY_PRIVATE_KEY=302e020100300506032b657004220420...
MY_ACCOUNT_ID=0.0.xxxxx
MY_PRIVATE_KEY=302e020100300506032b657004220420...

# Hedera Mirror Node (Optional - defaults to testnet)
NEXT_PUBLIC_HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# =============================================================================
# Pinata IPFS Configuration (Optional - for NFT certificates)
# =============================================================================
# Get JWT from: https://app.pinata.cloud/developers/api-keys
NEXT_PUBLIC_PINATA_JWT_TOKEN=your_pinata_jwt_token_here
PINATA_JWT=your_pinata_jwt_token_here

# Legacy Pinata keys (optional if using JWT)
NEXT_PUBLIC_PINATA_API_KEY=your_pinata_api_key_here
NEXT_PUBLIC_PINATA_SECRET_KEY=your_pinata_secret_key_here
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud

# =============================================================================
# Bot Configuration (Required for Telegram/WhatsApp integration)
# =============================================================================
# Get bot token from: https://t.me/BotFather (use /newbot command)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BOT_SERVER_TOKEN=your_secure_random_token_here
HOMEBASE_API_URL=https://your-homebaise-app.vercel.app
BOT_SKIP_DB=false

# =============================================================================
# Server Configuration (Optional - has defaults)
# =============================================================================
PORT=3000
NODE_ENV=development

# =============================================================================
# Advanced Configuration (Optional)
# =============================================================================
# Certificate NFT Configuration
CERTIFICATE_TOKEN_ID=

# Debug Mode
NEXT_PUBLIC_DEBUG=false

# =============================================================================
# Ollama AI Configuration (Optional - for property valuation)
# =============================================================================
# Local AI server for property valuation
# Install: curl https://ollama.ai/install.sh | sh
# Run: ollama pull deepseek-coder && ollama serve
OLLAMA_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
